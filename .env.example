NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=jemacash

# JWT
JWT_SECRET=change-me-strong-secret-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars

# Server
PORT=3000
FRONTEND_URL=http://localhost:5173


# Mercado Pago – obtener en https://www.mercadopago.com.pe/developers/panel/app
MP_ACCESS_TOKEN=TEST-......

# Gmail SMTP – Email OTP 2FA (gratis, sin límites)
# SMTP_PASS debe ser una "Contraseña de aplicación" de Google (no tu contraseña normal)
# Cómo obtenerla: myaccount.google.com → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones
SMTP_USER=diavlo@gmail.com
SMTP_PASS=XXXX XXXX XXXX XXXX

# Google OAuth – obtener en https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Groq AI – obtener en https://console.groq.com (gratis, sin tarjeta, 500 req/día)
GROQ_API_KEY=REEMPLAZAR_CON_TU_API_KEY

# MercadoLibre – precios REALES de listings peruanos (sites/MPE) para la valuación.
# Opcional: sin esto los precios salen de la estimación del LLM (menos preciso).
# Crea una app en https://developers.mercadolibre.com.pe, habilita el flujo
# "Client Credentials" y el negocio "Mercado Libre", y copia Client ID + Secret.
# El server obtiene y renueva el token solo (client_credentials) — sin refresh token.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
